# CrawlX Configuration
PORT=3000

# OpenRouter API Key for Natural Language LLM Extraction
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# CrawlX Endpoint Protection (Optional)
# If specified, external requests to /api/* must include "x-api-key" or "Authorization: Bearer <key>"
CRAWLX_API_KEY=your_optional_crawlx_security_key

# Default LLM Model (100% Free on OpenRouter — costs $0.00)
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Default Embedding Model (100% Free on OpenRouter — costs $0.00)
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b:free
